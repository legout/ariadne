# Live LLM credentials for ariadne-author (secrets: never commit the real .env).
# cp .env.example .env, fill in, and point ARIADNE_ENV at it if it lives elsewhere.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Docker Compose: external data project, not this software checkout.
# Use its absolute standalone Git repository root, mounted at the same path.
ARIADNE_PROJECT_DIR=
ARIADNE_HTTP_TOKEN=
# Set UID/GID to the data-project owner (id -u / id -g on a single-user host).
ARIADNE_UID=1000
ARIADNE_GID=1000
ARIADNE_TOOLSET=combined
# Exact Host/Origin used by your private HTTPS MCP client or proxy.
ARIADNE_MCP_HOST=mcp.example.org
ARIADNE_MCP_ORIGIN=https://mcp.example.org
