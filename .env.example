# Live LLM credentials for ariadne-author (secrets: never commit the real .env).
# cp .env.example .env, fill in, and point ARIADNE_ENV at it if it lives elsewhere.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Docker Compose: external data project, not this software checkout.
# Use its absolute standalone Git repository root, mounted at the same path.
ARIADNE_PROJECT_DIR=
ARIADNE_HTTP_TOKEN=
# Set UID/GID to the data-project owner (id -u / id -g on a single-user host).
ARIADNE_UID=1000
ARIADNE_GID=1000
ARIADNE_TOOLSET=combined
# Exact Host/Origin used by your private HTTPS MCP client or proxy.
ARIADNE_MCP_HOST=mcp.example.org
ARIADNE_MCP_ORIGIN=https://mcp.example.org

# Named S3 storage profiles (development candidate, not published 0.3.0):
# ariadne.yaml's storages: block names THESE variables — supply the values in
# the executing process's environment (Shell, MCP launcher, or the container's
# env_file/environment — never an Ariadne-managed .env search). Example names:
# match your own profile declarations exactly. Compose's --env-file flag only
# interpolates host-side variables; it does not inject the container env.
# LOCAL_S3_ACCESS_KEY_ID=
# LOCAL_S3_SECRET_ACCESS_KEY=
# LOCAL_S3_ENDPOINT_URL=https://s3.retail.example.org
# REMOTE_S3_ACCESS_KEY_ID=
# REMOTE_S3_SECRET_ACCESS_KEY=
# REMOTE_S3_ENDPOINT_URL=https://s3.analytics.example.org
# REMOTE_S3_REGION=us-east-1
